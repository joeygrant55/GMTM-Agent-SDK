# GMTM Agent SDK Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================
# AUTH — Clerk JWT verification (REQUIRED in prod)
# ============================================
# The backend now verifies a Clerk session JWT on every workspace request and
# checks resource ownership. These MUST be set in the backend (Railway) env.

# Your Clerk Frontend API origin. JWKS is fetched from {CLERK_ISSUER}/.well-known/jwks.json
#   Production: https://clerk.<your-domain>.com
#   Development: https://<slug>.clerk.accounts.dev
CLERK_ISSUER=

# Optional: comma-separated allowed `azp` origins (token authorized-party check)
CLERK_AUTHORIZED_PARTIES=https://sparq-agent.vercel.app

# Set to "false" ONLY for local dev to bypass verification. Leave unset/true in prod.
AUTH_ENFORCED=true

# Shared secret so the Next.js /api/demo-chat proxy can reach the public agent demo
# without a Clerk token. Set the SAME value in BOTH the backend and the frontend
# (frontend: DEMO_PROXY_SECRET, server-side only — never NEXT_PUBLIC_*).
DEMO_PROXY_SECRET=

# Comma-separated allowed CORS origins (backend). Defaults to the prod Vercel app + localhost.
ALLOWED_ORIGINS=https://sparq-agent.vercel.app,http://localhost:3000,http://localhost:3001

# Signing secret for shareable report links. REQUIRED — sharing fails closed without it.
SHARE_TOKEN_SECRET=

# ============================================
# REQUIRED API KEYS
# ============================================

# E2B Sandbox API Key - Get from https://e2b.dev
E2B_API_KEY=e2b_your_key_here

# Anthropic API Key - Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ============================================
# EXISTING INTEGRATIONS
# ============================================

# Notion MCP Token - From Notion integrations
NOTION_TOKEN=secret_your_token_here

# GMTM Database URL (read-only)
GMTM_DB_URL=mysql://gmtmread:password@host:3306/gmtm

# SendGrid API Key - For email automation
SENDGRID_API_KEY=SG.your_key_here

# Verified sender for outreach emails. Required for real sends — without it, approvals
# transition the artifact to 'queued' (draft+queue default per outbound trust ladder).
SPARQ_FROM_EMAIL=
SPARQ_FROM_NAME=SPARQ Recruiting

# ============================================
# SOCIAL MEDIA APIs
# ============================================

# X/Twitter - From developer.twitter.com
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# LinkedIn - From LinkedIn Developer Portal
LINKEDIN_ACCESS_TOKEN=

# Instagram/Meta - From Meta for Developers
META_ACCESS_TOKEN=

# ============================================
# CRM & ANALYTICS (optional)
# ============================================

# HubSpot
HUBSPOT_API_KEY=

# Google Analytics
GA_MEASUREMENT_ID=
GA_API_SECRET=

# ── GMTM junior entry (profile surface, sparq.gmtm.com) ──
# No Clerk on this surface (rev 3, Joey 2026-10-01): GMTM sign-in is the only sign-in.
# Leave CLERK_* and NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY unset for the profile frontend and backend.
# Add https://sparq.gmtm.com to ALLOWED_ORIGINS on that host.
# Backend: shared secret the Next server sends to POST /gmtm-entry/exchange (503 when unset).
SPARQ_ENTRY_SECRET=
# Backend: secret sent as x-sparq-secret to {GMTM_API_URL}/v2/sparq/redeem.
SPARQ_HANDOFF_SECRET=
GMTM_API_URL=
# Backend AND profile frontend (server-only, never NEXT_PUBLIC_*): HS256 key for the
# 24 h SPARQ session token. At least 32 bytes, e.g. `openssl rand -base64 48`.
SPARQ_SESSION_SECRET=
# Backend: comma-separated GMTM user_ids always admitted (Joey's test list).
SPARQ_TEST_ALLOWLIST=
# Frontend: GMTM web origin for /sparq/authorize, "Not you? Switch" and sign-out. Also set SPARQ_ENTRY_SECRET there.
NEXT_PUBLIC_GMTM_WEB_URL=
