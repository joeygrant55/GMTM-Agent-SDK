# GMTM Agent SDK Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================
# AUTH — GMTM sign-in only (Joey 2026-10-01; REQUIRED in prod)
# ============================================
# Every surface (legacy, combine, profile) signs in through GMTM. The Next server
# exchanges a one-use GMTM code at POST /gmtm-entry/exchange for a 24 h SPARQ
# session token (HttpOnly __Host-sparq-session cookie). Without these settings every
# protected request returns 503 (fail closed). There is no development bypass.
# HOSTING PRECONDITION: serve every frontend surface from a gmtm.com subdomain (for
# example sparq.gmtm.com) and set NEXT_PUBLIC_GMTM_WEB_URL. Sign-in reads GMTM's
# .gmtm.com sessionId cookie; a vercel.app or other domain can never sign in.
# Profile admits the junior gate (cohort + age 13-17) or SPARQ_TEST_ALLOWLIST;
# legacy and combine admit SPARQ_TEST_ALLOWLIST only.

# Backend: shared secret the Next server sends to POST /gmtm-entry/exchange.
SPARQ_ENTRY_SECRET=
# Backend: secret sent as x-sparq-secret to {GMTM_API_URL}/v2/sparq/redeem.
SPARQ_HANDOFF_SECRET=
GMTM_API_URL=
# Backend AND frontend (server-only, never NEXT_PUBLIC_*): HS256 key for the
# SPARQ session token. At least 32 bytes, e.g. `openssl rand -base64 48`.
SPARQ_SESSION_SECRET=
# Backend: comma-separated GMTM user_ids always admitted (Joey's test list).
SPARQ_TEST_ALLOWLIST=
# Frontend: GMTM web origin for /sparq/authorize, "Not you? Switch" and sign-out.
# Also set SPARQ_ENTRY_SECRET and SPARQ_SESSION_SECRET there.
NEXT_PUBLIC_GMTM_WEB_URL=

# Shared secret so the Next.js /api/demo-chat proxy can reach the public agent demo
# without a SPARQ session. Set the SAME value in BOTH the backend and the frontend
# (frontend: DEMO_PROXY_SECRET, server-side only — never NEXT_PUBLIC_*).
DEMO_PROXY_SECRET=

# Comma-separated allowed CORS origins (backend). Set explicitly; gmtm.com subdomains only.
ALLOWED_ORIGINS=https://sparq.gmtm.com,http://localhost:3000,http://localhost:3001

# Signing secret for shareable report links. REQUIRED — sharing fails closed without it.
SHARE_TOKEN_SECRET=

# ============================================
# REQUIRED API KEYS
# ============================================

# E2B Sandbox API Key - Get from https://e2b.dev
E2B_API_KEY=e2b_your_key_here

# Anthropic API Key - Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ============================================
# EXISTING INTEGRATIONS
# ============================================

# Notion MCP Token - From Notion integrations
NOTION_TOKEN=secret_your_token_here

# GMTM Database URL (read-only)
GMTM_DB_URL=mysql://gmtmread:password@host:3306/gmtm

# SendGrid API Key - For email automation
SENDGRID_API_KEY=SG.your_key_here

# Verified sender for outreach emails. Required for real sends — without it, approvals
# transition the artifact to 'queued' (draft+queue default per outbound trust ladder).
SPARQ_FROM_EMAIL=
SPARQ_FROM_NAME=SPARQ Recruiting

# ============================================
# SOCIAL MEDIA APIs
# ============================================

# X/Twitter - From developer.twitter.com
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# LinkedIn - From LinkedIn Developer Portal
LINKEDIN_ACCESS_TOKEN=

# Instagram/Meta - From Meta for Developers
META_ACCESS_TOKEN=

# ============================================
# CRM & ANALYTICS (optional)
# ============================================

# HubSpot
HUBSPOT_API_KEY=

# Google Analytics
GA_MEASUREMENT_ID=
GA_API_SECRET=

# ── Profile surface (sparq.gmtm.com) ──
# Add https://sparq.gmtm.com to ALLOWED_ORIGINS on that host. GMTM sign-in settings
# are in the AUTH section above.
